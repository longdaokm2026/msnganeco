# Docker images published by GitHub Actions. Do not append a tag here.
WEB_IMAGE="ghcr.io/your-github-owner/msnganeco-web"
API_IMAGE="ghcr.io/your-github-owner/msnganeco-api"
IMAGE_TAG="replace-with-a-git-commit-sha"

# Public DNS records pointing to the Ubuntu application server.
WEB_DOMAIN="app.example.com"
API_DOMAIN="api.example.com"
TLS_EMAIL="admin@example.com"

# API runtime. PostgreSQL must be reachable only over a private network or SSL.
DATABASE_URL="postgresql://msngan:replace-me@private-db-host:5432/msngan?schema=public&sslmode=require"
API_PORT="4000"
WEB_ORIGIN="https://app.example.com"
NEXT_PUBLIC_API_URL="https://api.example.com"

JWT_ACCESS_SECRET="replace-with-output-from-openssl-rand-base64-48"
JWT_ISSUER="msngan-api"
JWT_AUDIENCE="msngan-web"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_SECONDS="2592000"
COOKIE_SECURE="true"
AUTH_EXPOSE_DEV_TOKENS="false"

# Enable temporarily only when intentionally creating/rotating the first Admin.
SEED_ADMIN="false"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_FULL_NAME=""
ADMIN_PHONE=""
