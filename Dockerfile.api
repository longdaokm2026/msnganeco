# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS dependencies

WORKDIR /app
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@11.19.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY prisma ./prisma
COPY prisma.config.ts ./prisma.config.ts
RUN DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build" pnpm db:generate

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    API_PORT=4000
WORKDIR /app
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --from=dependencies --chown=node:node /app/generated ./generated
COPY --chown=node:node package.json prisma.config.ts tsconfig.json ./
COPY --chown=node:node apps/api ./apps/api
COPY --chown=node:node server ./server
COPY --chown=node:node prisma ./prisma

USER node
EXPOSE 4000
CMD ["./node_modules/.bin/tsx", "apps/api/src/main.ts"]
