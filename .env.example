# Local PostgreSQL connection. Replace every credential in staging/production.
DATABASE_URL="postgresql://msngan:msngan_local_password@localhost:5432/msngan?schema=public"

# Admin cannot register publicly. Enable only while intentionally creating or
# rotating the bootstrap Admin account with `pnpm db:seed`.
SEED_ADMIN="false"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_FULL_NAME=""
ADMIN_PHONE=""

# Local API
API_PORT="4000"
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
LESSON_UPLOAD_DIR="/tmp/msngan-lessons"
ASSIGNMENT_UPLOAD_DIR="/tmp/msngan-assignments/audio"

# Use long, random and different secrets outside local development.
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_ISSUER="msngan-api"
JWT_AUDIENCE="msngan-web"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_SECONDS="2592000"
COOKIE_SECURE="false"
AUTH_EXPOSE_DEV_TOKENS="false"
