generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  GUARDIAN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum TeacherApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
}

enum ClassroomStatus {
  ACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  REMOVED
}

enum ClassSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AbsenceRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum GuardianLinkStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
}

model User {
  id                String              @id @default(uuid()) @db.Uuid
  email             String              @unique @db.Citext
  phone             String?             @unique @db.VarChar(20)
  passwordHash      String              @map("password_hash") @db.VarChar(255)
  fullName          String              @map("full_name") @db.VarChar(120)
  status            UserStatus          @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?           @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt   DateTime?           @map("phone_verified_at") @db.Timestamptz(3)
  lastLoginAt       DateTime?           @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles             UserRole[]
  studentProfile    StudentProfile?
  teacherProfile    TeacherProfile?
  guardianProfile   GuardianProfile?
  refreshTokens     RefreshToken[]
  verificationTokens VerificationToken[]
  auditLogs         AuditLog[]          @relation("AuditActor")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  role       Role
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

model StudentProfile {
  userId       String            @id @map("user_id") @db.Uuid
  studentCode  String?           @unique @map("student_code") @db.VarChar(30)
  dateOfBirth  DateTime?         @map("date_of_birth") @db.Date
  schoolName   String?           @map("school_name") @db.VarChar(160)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardianLinks StudentGuardian[]
  enrollments   ClassEnrollment[]
  attendances   AttendanceRecord[]
  absenceRequests AbsenceRequest[]

  @@map("student_profiles")
}

model TeacherProfile {
  userId         String                @id @map("user_id") @db.Uuid
  bio            String?
  approvalStatus TeacherApprovalStatus @default(PENDING) @map("approval_status")
  approvedAt     DateTime?             @map("approved_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  classrooms     Classroom[]
  attendanceMarks AttendanceRecord[] @relation("AttendanceMarker")
  reviewedAbsences AbsenceRequest[]   @relation("AbsenceReviewer")

  @@index([approvalStatus])
  @@map("teacher_profiles")
}

model Classroom {
  id           String          @id @default(uuid()) @db.Uuid
  teacherId    String          @map("teacher_id") @db.Uuid
  code         String          @unique @db.VarChar(12)
  name         String          @db.VarChar(120)
  description  String?
  level        String?         @db.VarChar(60)
  scheduleNote String?         @map("schedule_note") @db.VarChar(160)
  maxStudents  Int             @default(30) @map("max_students")
  status       ClassroomStatus @default(ACTIVE)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  teacher      TeacherProfile  @relation(fields: [teacherId], references: [userId], onDelete: Restrict)
  enrollments  ClassEnrollment[]
  sessions     ClassSession[]

  @@index([teacherId, status])
  @@index([name])
  @@map("classrooms")
}

model ClassEnrollment {
  classroomId String           @map("classroom_id") @db.Uuid
  studentId   String           @map("student_id") @db.Uuid
  status      EnrollmentStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  removedAt   DateTime?        @map("removed_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  classroom   Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student     StudentProfile   @relation(fields: [studentId], references: [userId], onDelete: Restrict)

  @@id([classroomId, studentId])
  @@index([studentId, status])
  @@index([classroomId, status])
  @@map("class_enrollments")
}

model ClassSession {
  id             String             @id @default(uuid()) @db.Uuid
  classroomId    String             @map("classroom_id") @db.Uuid
  title          String             @db.VarChar(160)
  topic          String?
  scheduledStart DateTime           @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd   DateTime           @map("scheduled_end") @db.Timestamptz(3)
  status         ClassSessionStatus @default(SCHEDULED)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  classroom      Classroom          @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  attendances    AttendanceRecord[]
  absenceRequests AbsenceRequest[]

  @@unique([classroomId, scheduledStart])
  @@index([scheduledStart, status])
  @@map("class_sessions")
}

model AttendanceRecord {
  sessionId  String           @map("session_id") @db.Uuid
  studentId  String           @map("student_id") @db.Uuid
  status     AttendanceStatus
  note       String?          @db.VarChar(500)
  markedById String           @map("marked_by_id") @db.Uuid
  markedAt   DateTime         @default(now()) @map("marked_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  session    ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student    StudentProfile   @relation(fields: [studentId], references: [userId], onDelete: Restrict)
  markedBy   TeacherProfile   @relation("AttendanceMarker", fields: [markedById], references: [userId], onDelete: Restrict)

  @@id([sessionId, studentId])
  @@index([studentId, status])
  @@map("attendance_records")
}

model AbsenceRequest {
  id           String               @id @default(uuid()) @db.Uuid
  sessionId    String               @map("session_id") @db.Uuid
  studentId    String               @map("student_id") @db.Uuid
  reason       String               @db.VarChar(1000)
  status       AbsenceRequestStatus @default(PENDING)
  reviewedById String?              @map("reviewed_by_id") @db.Uuid
  reviewNote   String?              @map("review_note") @db.VarChar(500)
  reviewedAt   DateTime?            @map("reviewed_at") @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  session      ClassSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student      StudentProfile       @relation(fields: [studentId], references: [userId], onDelete: Restrict)
  reviewedBy   TeacherProfile?      @relation("AbsenceReviewer", fields: [reviewedById], references: [userId], onDelete: Restrict)

  @@unique([sessionId, studentId])
  @@index([studentId, status])
  @@index([sessionId, status])
  @@map("absence_requests")
}

model GuardianProfile {
  userId       String            @id @map("user_id") @db.Uuid
  occupation   String?           @db.VarChar(120)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentLinks StudentGuardian[]

  @@map("guardian_profiles")
}

model StudentGuardian {
  studentId        String             @map("student_id") @db.Uuid
  guardianId       String             @map("guardian_id") @db.Uuid
  relationship     String             @db.VarChar(40)
  status           GuardianLinkStatus @default(PENDING)
  isPrimaryContact Boolean            @default(false) @map("is_primary_contact")
  canViewGrades    Boolean            @default(true) @map("can_view_grades")
  canViewAttendance Boolean           @default(true) @map("can_view_attendance")
  requestedAt      DateTime           @default(now()) @map("requested_at") @db.Timestamptz(3)
  respondedAt      DateTime?          @map("responded_at") @db.Timestamptz(3)
  revokedAt        DateTime?          @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  student          StudentProfile     @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  guardian         GuardianProfile    @relation(fields: [guardianId], references: [userId], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId, status])
  @@index([studentId, status])
  @@map("student_guardians")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  familyId    String    @default(uuid()) @map("family_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  ipAddress   String?   @map("ip_address") @db.Inet
  userAgent   String?   @map("user_agent") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  purpose   VerificationPurpose
  tokenHash String              @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?           @map("used_at") @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("verification_tokens")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
