generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  GUARDIAN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
  SUSPENDED
  DEACTIVATED
}

enum TeacherApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
}

enum ClassroomStatus {
  ACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  REMOVED
}

enum ClassSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AbsenceRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum GuardianLinkStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonAttachmentCategory {
  IMAGE
  DOCUMENT
  WORKSHEET
  READING
  SLIDE
  OTHER
}

enum AssignmentType {
  PRACTICE
  HOMEWORK
  QUIZ
  TEST
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum AssignmentGenerationMode {
  MANUAL
  AI
  LOCAL
}

enum AssignmentSection {
  VOCABULARY
  GRAMMAR
  READING
}

enum AssignmentQuestionType {
  VOCAB_MULTIPLE_CHOICE
  VOCAB_MATCHING
  VOCAB_FILL_BLANK
  GRAMMAR_MULTIPLE_CHOICE
  GRAMMAR_FILL_BLANK
  GRAMMAR_SENTENCE_ORDER
  GRAMMAR_ERROR_CORRECTION
  READING_MULTIPLE_CHOICE
  READING_TRUE_FALSE_NOT_GIVEN
  READING_SHORT_ANSWER
}

enum AssignmentAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_GRADED
  PENDING_MANUAL_GRADE
  FULLY_GRADED
}

model User {
  id                String              @id @default(uuid()) @db.Uuid
  email             String              @unique @db.Citext
  phone             String?             @unique @db.VarChar(20)
  passwordHash      String              @map("password_hash") @db.VarChar(255)
  fullName          String              @map("full_name") @db.VarChar(120)
  status            UserStatus          @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?           @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt   DateTime?           @map("phone_verified_at") @db.Timestamptz(3)
  lastLoginAt       DateTime?           @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles             UserRole[]
  studentProfile    StudentProfile?
  teacherProfile    TeacherProfile?
  guardianProfile   GuardianProfile?
  refreshTokens     RefreshToken[]
  verificationTokens VerificationToken[]
  auditLogs         AuditLog[]          @relation("AuditActor")
  teacherApprovals  TeacherProfile[]    @relation("TeacherApprover")
  lessonsCreated    Lesson[]            @relation("LessonCreatedBy")
  lessonsUpdated    Lesson[]            @relation("LessonUpdatedBy")
  lessonUploads     LessonAttachment[]
  assignmentsCreated Assignment[]       @relation("AssignmentCreatedBy")
  assignmentAudioUploads AssignmentAudioAttachment[] @relation("AssignmentAudioUploadedBy")
  readAloudGrades    AssignmentReadAloudSubmission[] @relation("ReadAloudGrader")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  role       Role
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

model StudentProfile {
  userId       String            @id @map("user_id") @db.Uuid
  studentCode  String?           @unique @map("student_code") @db.VarChar(30)
  dateOfBirth  DateTime?         @map("date_of_birth") @db.Date
  schoolName   String?           @map("school_name") @db.VarChar(160)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardianLinks StudentGuardian[]
  enrollments   ClassEnrollment[]
  attendances   AttendanceRecord[]
  absenceRequests AbsenceRequest[]
  assignmentAttempts AssignmentAttempt[]
  readAloudSubmissions AssignmentReadAloudSubmission[]

  @@map("student_profiles")
}

model TeacherProfile {
  userId         String                @id @map("user_id") @db.Uuid
  bio            String?
  approvalStatus TeacherApprovalStatus @default(PENDING) @map("approval_status")
  approvedAt     DateTime?             @map("approved_at") @db.Timestamptz(3)
  approvedById   String?               @map("approved_by_id") @db.Uuid
  rejectedAt     DateTime?             @map("rejected_at") @db.Timestamptz(3)
  rejectionNote  String?               @map("rejection_note") @db.VarChar(500)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy     User?                 @relation("TeacherApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  classrooms     Classroom[]
  attendanceMarks AttendanceRecord[] @relation("AttendanceMarker")
  reviewedAbsences AbsenceRequest[]   @relation("AbsenceReviewer")

  @@index([approvalStatus])
  @@index([approvedById])
  @@map("teacher_profiles")
}

model Classroom {
  id           String          @id @default(uuid()) @db.Uuid
  teacherId    String          @map("teacher_id") @db.Uuid
  code         String          @unique @db.VarChar(12)
  name         String          @db.VarChar(120)
  description  String?
  level        String?         @db.VarChar(60)
  scheduleNote String?         @map("schedule_note") @db.VarChar(160)
  maxStudents  Int             @default(30) @map("max_students")
  status       ClassroomStatus @default(ACTIVE)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  teacher      TeacherProfile  @relation(fields: [teacherId], references: [userId], onDelete: Restrict)
  enrollments  ClassEnrollment[]
  sessions     ClassSession[]
  assignments  Assignment[]

  @@index([teacherId, status])
  @@index([name])
  @@map("classrooms")
}

model ClassEnrollment {
  classroomId String           @map("classroom_id") @db.Uuid
  studentId   String           @map("student_id") @db.Uuid
  status      EnrollmentStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  removedAt   DateTime?        @map("removed_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  classroom   Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student     StudentProfile   @relation(fields: [studentId], references: [userId], onDelete: Restrict)

  @@id([classroomId, studentId])
  @@index([studentId, status])
  @@index([classroomId, status])
  @@map("class_enrollments")
}

model ClassSession {
  id             String             @id @default(uuid()) @db.Uuid
  classroomId    String             @map("classroom_id") @db.Uuid
  title          String             @db.VarChar(160)
  topic          String?
  scheduledStart DateTime           @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd   DateTime           @map("scheduled_end") @db.Timestamptz(3)
  status         ClassSessionStatus @default(SCHEDULED)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  classroom      Classroom          @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  attendances    AttendanceRecord[]
  absenceRequests AbsenceRequest[]
  lesson          Lesson?

  @@unique([classroomId, scheduledStart])
  @@index([scheduledStart, status])
  @@map("class_sessions")
}

model Lesson {
  id            String       @id @default(uuid()) @db.Uuid
  sessionId     String       @unique @map("session_id") @db.Uuid
  status        LessonStatus @default(DRAFT)
  title         String       @db.VarChar(200)
  summary       String?
  mainContent   String?      @map("main_content")
  theory        String?
  vocabulary    String?
  grammar       String?
  examples      String?
  reviewNotes   String?      @map("review_notes")
  homeworkNotes String?      @map("homework_notes")
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById   String       @map("created_by_id") @db.Uuid
  updatedById   String       @map("updated_by_id") @db.Uuid
  session       ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy     User         @relation("LessonCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy     User         @relation("LessonUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  attachments   LessonAttachment[]
  assignments   Assignment[]

  @@index([status, updatedAt])
  @@map("lessons")
}

model LessonAttachment {
  id           String                   @id @default(uuid()) @db.Uuid
  lessonId     String                   @map("lesson_id") @db.Uuid
  fileName     String                   @map("file_name") @db.VarChar(255)
  fileType     String                   @map("file_type") @db.VarChar(150)
  fileSize     Int                      @map("file_size")
  storageKey   String                   @unique @map("storage_key") @db.VarChar(500)
  category     LessonAttachmentCategory @default(OTHER)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  uploadedById String                   @map("uploaded_by_id") @db.Uuid
  lesson       Lesson                   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  uploadedBy   User                     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([lessonId])
  @@map("lesson_attachments")
}

model Assignment {
  id                   String           @id @default(uuid()) @db.Uuid
  classroomId          String           @map("classroom_id") @db.Uuid
  lessonId             String?          @map("lesson_id") @db.Uuid
  createdById          String           @map("created_by_id") @db.Uuid
  title                String           @db.VarChar(200)
  description          String?
  type                 AssignmentType   @default(HOMEWORK)
  status               AssignmentStatus @default(DRAFT)
  dueAt                DateTime?        @map("due_at") @db.Timestamptz(3)
  allowLateSubmission  Boolean          @default(false) @map("allow_late_submission")
  maxAttempts          Int              @default(1) @map("max_attempts")
  timeLimitMinutes     Int?             @map("time_limit_minutes")
  shuffleQuestions     Boolean          @default(false) @map("shuffle_questions")
  shuffleOptions       Boolean          @default(false) @map("shuffle_options")
  showScoreImmediately Boolean          @default(true) @map("show_score_immediately")
  showAnswersAfterSubmit Boolean        @default(false) @map("show_answers_after_submit")
  showLeaderboard        Boolean        @default(true) @map("show_leaderboard")
  generationMode         AssignmentGenerationMode @default(MANUAL) @map("generation_mode")
  generationModel        String?        @map("generation_model") @db.VarChar(100)
  sourceLessonIds        String[]       @default([]) @map("source_lesson_ids") @db.Uuid
  publishedAt          DateTime?        @map("published_at") @db.Timestamptz(3)
  closedAt             DateTime?        @map("closed_at") @db.Timestamptz(3)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  classroom            Classroom        @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  lesson               Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy            User             @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  passages             AssignmentPassage[]
  questions            AssignmentQuestion[]
  attempts             AssignmentAttempt[]
  readAloudTask        AssignmentReadAloudTask?
  readAloudSubmissions AssignmentReadAloudSubmission[]

  @@index([classroomId])
  @@index([lessonId])
  @@index([status])
  @@index([dueAt])
  @@index([generationMode])
  @@map("assignments")
}

model AssignmentPassage {
  id           String               @id @default(uuid()) @db.Uuid
  assignmentId String               @map("assignment_id") @db.Uuid
  title        String?              @db.VarChar(200)
  content      String
  position     Int
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignment   Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  questions    AssignmentQuestion[]

  @@unique([assignmentId, position])
  @@index([assignmentId, position])
  @@map("assignment_passages")
}

model AssignmentQuestion {
  id           String                 @id @default(uuid()) @db.Uuid
  assignmentId String                 @map("assignment_id") @db.Uuid
  passageId    String?                @map("passage_id") @db.Uuid
  type         AssignmentQuestionType
  section      AssignmentSection
  position     Int
  prompt       String
  explanation  String?
  points       Decimal                @default(1) @db.Decimal(8, 2)
  required     Boolean                @default(true)
  config       Json
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignment   Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  passage      AssignmentPassage?     @relation(fields: [passageId], references: [id], onDelete: SetNull)
  answers      AssignmentAnswer[]

  @@unique([assignmentId, position])
  @@index([assignmentId, position])
  @@index([passageId])
  @@map("assignment_questions")
}

model AssignmentAttempt {
  id            String                  @id @default(uuid()) @db.Uuid
  assignmentId  String                  @map("assignment_id") @db.Uuid
  studentId     String                  @map("student_id") @db.Uuid
  attemptNumber Int                     @map("attempt_number")
  status        AssignmentAttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime                @default(now()) @map("started_at") @db.Timestamptz(3)
  submittedAt   DateTime?               @map("submitted_at") @db.Timestamptz(3)
  score         Decimal?                @db.Decimal(10, 2)
  maxScore      Decimal                 @default(0) @map("max_score") @db.Decimal(10, 2)
  percentage    Decimal?                @db.Decimal(6, 2)
  isLate        Boolean                 @default(false) @map("is_late")
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignment    Assignment              @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  student       StudentProfile          @relation(fields: [studentId], references: [userId], onDelete: Restrict)
  answers       AssignmentAnswer[]
  readAloudSubmission AssignmentReadAloudSubmission?

  @@unique([assignmentId, studentId, attemptNumber])
  @@index([assignmentId, studentId])
  @@index([studentId, status])
  @@map("assignment_attempts")
}

model AssignmentReadAloudTask {
  id                 String       @id @default(uuid()) @db.Uuid
  assignmentId       String       @unique @map("assignment_id") @db.Uuid
  title              String?      @db.VarChar(200)
  readingText        String       @map("reading_text")
  instructions       String?
  maxScore           Decimal      @default(10) @map("max_score") @db.Decimal(8, 2)
  maxDurationSeconds Int?         @default(300) @map("max_duration_seconds")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignment         Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissions        AssignmentReadAloudSubmission[]

  @@map("assignment_read_aloud_tasks")
}

model AssignmentAudioAttachment {
  id           String       @id @default(uuid()) @db.Uuid
  fileName     String       @map("file_name") @db.VarChar(255)
  fileType     String       @map("file_type") @db.VarChar(100)
  fileSize     Int          @map("file_size")
  storageKey   String       @unique @map("storage_key") @db.VarChar(500)
  uploadedById String       @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  uploadedBy   User         @relation("AssignmentAudioUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  submission   AssignmentReadAloudSubmission?

  @@index([uploadedById])
  @@map("assignment_audio_attachments")
}

model AssignmentReadAloudSubmission {
  id                String                    @id @default(uuid()) @db.Uuid
  assignmentId      String                    @map("assignment_id") @db.Uuid
  readAloudTaskId   String                    @map("read_aloud_task_id") @db.Uuid
  attemptId         String                    @unique @map("attempt_id") @db.Uuid
  studentId         String                    @map("student_id") @db.Uuid
  audioAttachmentId String                    @unique @map("audio_attachment_id") @db.Uuid
  durationSeconds   Int?                      @map("duration_seconds")
  submittedAt       DateTime?                 @map("submitted_at") @db.Timestamptz(3)
  score             Decimal?                  @db.Decimal(8, 2)
  feedback          String?
  gradedById        String?                   @map("graded_by_id") @db.Uuid
  gradedAt          DateTime?                 @map("graded_at") @db.Timestamptz(3)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignment        Assignment                @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  readAloudTask     AssignmentReadAloudTask   @relation(fields: [readAloudTaskId], references: [id], onDelete: Restrict)
  attempt           AssignmentAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  student           StudentProfile            @relation(fields: [studentId], references: [userId], onDelete: Restrict)
  audioAttachment   AssignmentAudioAttachment @relation(fields: [audioAttachmentId], references: [id], onDelete: Restrict)
  gradedBy          User?                     @relation("ReadAloudGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@index([assignmentId, studentId])
  @@index([readAloudTaskId])
  @@index([gradedById])
  @@map("assignment_read_aloud_submissions")
}

model AssignmentAnswer {
  id            String             @id @default(uuid()) @db.Uuid
  attemptId     String             @map("attempt_id") @db.Uuid
  questionId    String             @map("question_id") @db.Uuid
  answer        Json
  normalized    Json?
  isCorrect     Boolean?           @map("is_correct")
  awardedPoints Decimal?           @map("awarded_points") @db.Decimal(8, 2)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  attempt       AssignmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      AssignmentQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("assignment_answers")
}

model AttendanceRecord {
  sessionId  String           @map("session_id") @db.Uuid
  studentId  String           @map("student_id") @db.Uuid
  status     AttendanceStatus
  note       String?          @db.VarChar(500)
  markedById String           @map("marked_by_id") @db.Uuid
  markedAt   DateTime         @default(now()) @map("marked_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  session    ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student    StudentProfile   @relation(fields: [studentId], references: [userId], onDelete: Restrict)
  markedBy   TeacherProfile   @relation("AttendanceMarker", fields: [markedById], references: [userId], onDelete: Restrict)

  @@id([sessionId, studentId])
  @@index([studentId, status])
  @@map("attendance_records")
}

model AbsenceRequest {
  id           String               @id @default(uuid()) @db.Uuid
  sessionId    String               @map("session_id") @db.Uuid
  studentId    String               @map("student_id") @db.Uuid
  reason       String               @db.VarChar(1000)
  status       AbsenceRequestStatus @default(PENDING)
  reviewedById String?              @map("reviewed_by_id") @db.Uuid
  reviewNote   String?              @map("review_note") @db.VarChar(500)
  reviewedAt   DateTime?            @map("reviewed_at") @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  session      ClassSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student      StudentProfile       @relation(fields: [studentId], references: [userId], onDelete: Restrict)
  reviewedBy   TeacherProfile?      @relation("AbsenceReviewer", fields: [reviewedById], references: [userId], onDelete: Restrict)

  @@unique([sessionId, studentId])
  @@index([studentId, status])
  @@index([sessionId, status])
  @@map("absence_requests")
}

model GuardianProfile {
  userId       String            @id @map("user_id") @db.Uuid
  occupation   String?           @db.VarChar(120)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentLinks StudentGuardian[]

  @@map("guardian_profiles")
}

model StudentGuardian {
  studentId        String             @map("student_id") @db.Uuid
  guardianId       String             @map("guardian_id") @db.Uuid
  relationship     String             @db.VarChar(40)
  status           GuardianLinkStatus @default(PENDING)
  isPrimaryContact Boolean            @default(false) @map("is_primary_contact")
  canViewGrades    Boolean            @default(true) @map("can_view_grades")
  canViewAttendance Boolean           @default(true) @map("can_view_attendance")
  requestedAt      DateTime           @default(now()) @map("requested_at") @db.Timestamptz(3)
  respondedAt      DateTime?          @map("responded_at") @db.Timestamptz(3)
  revokedAt        DateTime?          @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  student          StudentProfile     @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  guardian         GuardianProfile    @relation(fields: [guardianId], references: [userId], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId, status])
  @@index([studentId, status])
  @@map("student_guardians")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  familyId    String    @default(uuid()) @map("family_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  ipAddress   String?   @map("ip_address") @db.Inet
  userAgent   String?   @map("user_agent") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  purpose   VerificationPurpose
  tokenHash String              @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?           @map("used_at") @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("verification_tokens")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
